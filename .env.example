# Argus environment — copy to .env and fill in. NEVER commit .env.
# Storage (G-01)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/argus?retryWrites=true&w=majority
GCS_BUCKET=<argus-evidence-bucket>
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Meta models (G-02, G-03)
META_API_KEY=<meta-api-key>
META_MODEL=muse-spark-1.3
SAM_MODEL=sam-3-1
META_TIMEOUT_MS=60000
META_MAX_RETRIES=3
# Ingestion / API
ARGUS_INGEST_TOKEN=<server-to-server-token>
PORT=8000
# Geometry (G-04)
CAD_REFERENCE_PLY=<path-to>/valve_CAD_reference_full_surface.ply
GEO_REGISTRATION_MAX_RMSE_MM=2.0
CLOSE_DRAIN_TIMEOUT_MS=30000
