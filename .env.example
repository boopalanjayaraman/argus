# Argus environment — copy to .env and fill in. NEVER commit .env.
# Storage (G-01)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/argus?retryWrites=true&w=majority
GCS_BUCKET=<argus-evidence-bucket>
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Google Cloud Logging
# Set GCP_PROJECT_ID to enable Cloud Logging; until then logs are structured
# JSON lines on stdout (same shape, collected by Docker/Cloud Run either way).
GCP_PROJECT_ID=<your-gcp-project-id>
GCP_LOG_NAME=argus
# Authorisation is separate from the project id: GCP_PROJECT_ID says *where*
# to write logs/objects; credentials say *as whom*. Locally set
# GOOGLE_APPLICATION_CREDENTIALS (above) to a service-account key, or run
# `gcloud auth application-default login`. On GCP (Cloud Run/GKE) omit it —
# the attached service account / workload identity is used automatically.
LOG_LEVEL=info
SERVICE_NAME=argus-api
# Inspection service (Python) reads the same keys:
INSPECTION_SERVICE_URL=http://localhost:8100
AGENT_TRANSPORT=http
VIDEO_AGENT_URL=http://127.0.0.1:8101
IMAGE_AGENT_URL=http://127.0.0.1:8102
POINTCLOUD_AGENT_URL=http://127.0.0.1:8103
AGENT_JOBS_FILE=data/agent_jobs.json
AGENT_MAX_RETRIES=3

# Meta models (G-02, G-03)
META_API_KEY=<meta-api-key>
META_MODEL=muse-spark-1.3
SAM_MODEL=sam-3-1
META_TIMEOUT_MS=60000
META_MAX_RETRIES=3
# Ingestion / API
ARGUS_INGEST_TOKEN=<server-to-server-token>
PORT=8000
# Geometry (G-04)
CAD_REFERENCE_PLY=<path-to>/valve_CAD_reference_full_surface.ply
GEO_REGISTRATION_MAX_RMSE_MM=2.0
CLOSE_DRAIN_TIMEOUT_MS=30000
