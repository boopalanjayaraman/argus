# Argus environment — copy to .env and fill in. NEVER commit .env.
# Storage (G-01)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/argus?retryWrites=true&w=majority
# Database name: `argus` is the cloud deployment's; local runs default to `argus-local` (never share one)
MONGODB_DB=argus-local
GCS_BUCKET=<argus-evidence-bucket>
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Google Cloud Logging
# Set GCP_PROJECT_ID to enable Cloud Logging; until then logs are structured
# JSON lines on stdout (same shape, collected by Docker/Cloud Run either way).
GCP_PROJECT_ID=<your-gcp-project-id>
GCP_LOG_NAME=argus
# Authorisation is separate from the project id: GCP_PROJECT_ID says *where*
# to write logs/objects; credentials say *as whom*. Locally set
# GOOGLE_APPLICATION_CREDENTIALS (above) to a service-account key, or run
# `gcloud auth application-default login`. On GCP (Cloud Run/GKE) omit it —
# the attached service account / workload identity is used automatically.
LOG_LEVEL=info
SERVICE_NAME=argus-api
# Inspection service (Python) reads the same keys:
INSPECTION_SERVICE_URL=http://localhost:8100
AGENT_TRANSPORT=http
VIDEO_AGENT_URL=http://127.0.0.1:8101
IMAGE_AGENT_URL=http://127.0.0.1:8102
POINTCLOUD_AGENT_URL=http://127.0.0.1:8103
AGENT_JOBS_FILE=data/agent_jobs.json
AGENT_MAX_RETRIES=3

# Meta models (G-02, G-03)
META_API_KEY=<meta-api-key>
# Tiered routing: fast model screens ALL video/photo; flagship reviews only
# flagged/high-stakes photos. Confirm both model ids on your account at
# smoke-test time (META_REVIEW_MODEL especially — do not assume a version).
META_SCREEN_MODEL=muse-spark-1.3
META_REVIEW_MODEL=muse-wonder-1.0
META_MODEL=muse-spark-1.3
# SAM 3.1 (Meta Model API id, one concept per request; masks parsed with meta-sam-parser)
META_SAM_MODEL=sam-3.1
SAM_CONCURRENCY=10
SAM_MIN_CONFIDENCE=0.5
SAM_TIMEOUT_MS=240000
# Model input: photos downscaled / video keyframes (long edge, px); VIDEO_SCREEN_MODE=clip sends whole segments
MODEL_IMAGE_MAX_EDGE=1280
META_ADAPTER_LIVE=
META_TIMEOUT_MS=60000
META_MAX_RETRIES=3
# Ingestion / API
# Runtime data (evidence, documents, dossiers, merged video) and the working DB file
ARGUS_DATA_DIR=
ARGUS_DB_FILE=
ARGUS_INGEST_TOKEN=<server-to-server-token>
PORT=8000
# Live analysis: concurrent photo/video jobs; one video segment in N is analysed (plus the last)
ANALYSIS_CONCURRENCY=6
VIDEO_ANALYSIS_EVERY=4
MAX_ORDER_UPLOAD_MB=25
SSE_HEARTBEAT_MS=15000
# Geometry (G-04)
CAD_REFERENCE_PLY=
# Registration quality required before any scan rule is decided (scan tolerances live in rule metadata)
GEO_MIN_FITNESS=0.9
GEO_MIN_COVERAGE=0.3
# End Inspection waits this long for running analysis, then records the rest as incomplete
CLOSE_DRAIN_TIMEOUT_MS=120000
