# Argus API + Web (Fastify serves the built React app). Build from repo root.
FROM node:22-slim AS build
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json apps/web/
RUN cd apps/web && npm ci
COPY apps/api/package.json apps/api/package-lock.json apps/api/
RUN cd apps/api && npm ci
COPY apps/web apps/web
COPY apps/api apps/api
RUN cd apps/web && npm run build && cd ../api && npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production PORT=8000
COPY --from=build /app/apps/api/package.json /app/apps/api/package-lock.json apps/api/
RUN cd apps/api && npm ci --omit=dev
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/web/dist apps/web/dist
COPY src/cad_models.json src/cad_models.json
COPY src/data src/data
COPY reference-data reference-data
RUN mkdir -p data
EXPOSE 8000
CMD ["node", "apps/api/dist/server.js"]
