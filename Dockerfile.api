# Argus API + Web (Fastify serves the built React app). Build from repo root.
FROM node:22-slim AS build
WORKDIR /app
COPY src/apps/web/package.json src/apps/web/package-lock.json src/apps/web/
RUN cd src/apps/web && npm ci
COPY src/apps/api/package.json src/apps/api/package-lock.json src/apps/api/
RUN cd src/apps/api && npm ci
COPY src/apps/web src/apps/web
COPY src/apps/api src/apps/api
RUN cd src/apps/web && npm run build && cd ../api && npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production PORT=8000
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/src/apps/api/package.json /app/src/apps/api/package-lock.json src/apps/api/
RUN cd src/apps/api && npm ci --omit=dev
COPY --from=build /app/src/apps/api/dist src/apps/api/dist
COPY --from=build /app/src/apps/web/dist src/apps/web/dist
COPY src/cad_models.json src/cad_models.json
COPY src/data src/data
COPY src/reference-data src/reference-data
COPY src/inspection_rules src/inspection_rules
RUN mkdir -p data
EXPOSE 8000
CMD ["node", "src/apps/api/dist/server.js"]
